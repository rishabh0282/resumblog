---
interface Body {
  name: string;
  phase: string;
  role: string;
}

interface Props {
  bodies: Body[];
  note?: string;
}

const { bodies, note } = Astro.props;

const phaseColors: Record<string, string> = {
  Driver: '#f5a623',
  Ancient: '#b5b5b5',
  Degrading: '#e8c97a',
  Active: '#4e9cf0',
  Dormant: '#c1440e',
  Absorbing: '#c88b50',
  Accumulating: '#d4b06a',
  Intake: '#3f54ba',
  Awakening: '#aaffee',
};
---

<div class="od-wrapper">
  <!-- Mobile fallback list -->
  <ul class="od-mobile-list" aria-label="Solar system bodies and their lifecycle phases">
    {bodies.map((b) => (
      <li>
        <span class="od-m-name">{b.name}</span>
        <span class="od-m-phase">{b.phase}</span>
        <span class="od-m-role">{b.role}</span>
      </li>
    ))}
  </ul>

  <!-- Desktop diagram -->
  <div class="od-diagram" aria-label="Solar system orbit diagram">
    <div class="od-sun" aria-hidden="true"></div>

    <div class="od-track" role="list" aria-label="Planets in lifecycle sequence">
      {bodies.filter((b) => b.name !== 'Sun').map((b) => {
        const color = phaseColors[b.phase] ?? '#888888';
        return (
          <div
            class="od-body"
            role="button"
            tabindex="0"
            aria-label={`${b.name}: ${b.phase}`}
            data-name={b.name}
            data-phase={b.phase}
            data-role={b.role}
            style={`--dot-color: ${color};`}
          >
            <div class="od-dot" aria-hidden="true"></div>
            <span class="od-label">{b.name}</span>
            <span class="od-phase-label">{b.phase}</span>
          </div>
        );
      })}
    </div>

    <div class="od-panel glass" id="od-panel" aria-live="polite">
      <p class="od-panel-hint">Click or tap a body to see its role in the lifecycle</p>
      <h3 class="od-panel-title"></h3>
      <p class="od-panel-phase"></p>
      <p class="od-panel-body"></p>
    </div>

    {note && <p class="od-note">{note}</p>}
  </div>
</div>

<style>
  .od-wrapper { margin: 2rem 0; }

  /* Mobile */
  .od-mobile-list {
    display: none;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .od-mobile-list li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border);
  }

  .od-m-name {
    font-family: 'Inter Tight', sans-serif;
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--text-primary);
  }

  .od-m-phase {
    font-family: 'Geist Mono', monospace;
    font-size: 0.7rem;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .od-m-role {
    font-family: 'Source Serif 4', serif;
    font-style: italic;
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* Desktop */
  .od-sun {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #fff9a0, #f5a623, #c8590a);
    box-shadow: 0 0 28px 6px rgba(200, 131, 58, 0.4);
    margin: 0 auto 1.25rem;
  }

  .od-track {
    display: flex;
    align-items: flex-start;
    gap: 0.4rem;
    overflow-x: auto;
    padding: 0.75rem 0 1.25rem;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }

  .od-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    flex: 0 0 72px;
    padding: 0.5rem 0.25rem;
    border-radius: 4px;
    border: 1px solid transparent;
    cursor: pointer;
    transition: border-color 0.2s, transform 0.2s;
  }

  .od-body:hover,
  .od-body:focus,
  .od-body.active {
    border-color: var(--dot-color);
    box-shadow: 0 0 8px rgba(255, 255, 255, 0.08);
    outline: none;
    transform: translateY(-3px);
  }

  .od-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--dot-color);
    opacity: 0.85;
  }

  .od-label {
    font-family: 'Geist Mono', monospace;
    font-size: 0.575rem;
    color: var(--text-muted);
    text-align: center;
    line-height: 1.2;
  }

  .od-phase-label {
    font-family: 'Source Serif 4', serif;
    font-style: italic;
    font-size: 0.55rem;
    color: var(--text-muted);
    text-align: center;
    opacity: 0.55;
    line-height: 1.2;
  }

  .od-panel {
    min-height: 120px;
    padding: 1rem 1.25rem;
    border-radius: 4px;
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .od-panel-hint {
    font-family: 'Geist Mono', monospace;
    font-size: 0.6rem;
    color: var(--text-muted);
    opacity: 0.6;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .od-panel-title {
    font-family: 'Inter Tight', sans-serif;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }

  .od-panel-phase {
    font-family: 'Geist Mono', monospace;
    font-size: 0.7rem;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0;
  }

  .od-panel-body {
    font-family: 'Source Serif 4', serif;
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.65;
    margin: 0;
  }

  .od-note {
    font-family: 'Geist Mono', monospace;
    font-size: 0.7rem;
    color: var(--text-muted);
    text-align: center;
    margin-top: 0.75rem;
    opacity: 0.5;
  }

  @media (max-width: 767px) {
    .od-diagram { display: none; }
    .od-mobile-list { display: flex; flex-direction: column; }
  }
</style>

<script>
  const bodies = document.querySelectorAll('.od-body');
  const panel = document.getElementById('od-panel');

  if (panel) {
    const hintEl = panel.querySelector('.od-panel-hint') as HTMLElement;
    const titleEl = panel.querySelector('.od-panel-title') as HTMLElement;
    const phaseEl = panel.querySelector('.od-panel-phase') as HTMLElement;
    const bodyEl = panel.querySelector('.od-panel-body') as HTMLElement;

    const activate = (el: Element) => {
      bodies.forEach((b) => b.classList.remove('active'));
      el.classList.add('active');
      if (hintEl) hintEl.style.display = 'none';
      if (titleEl) titleEl.textContent = el.getAttribute('data-name') ?? '';
      if (phaseEl) phaseEl.textContent = el.getAttribute('data-phase') ?? '';
      if (bodyEl) bodyEl.textContent = el.getAttribute('data-role') ?? '';
    };

    bodies.forEach((b) => {
      b.addEventListener('click', () => activate(b));
      b.addEventListener('keydown', (e) => {
        const ke = e as KeyboardEvent;
        if (ke.key === 'Enter' || ke.key === ' ') {
          e.preventDefault();
          activate(b);
        }
      });
    });
  }
</script>
