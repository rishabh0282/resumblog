---
interface Props {
  name: string;
  icon: string;
  color: 'gold' | 'rust' | 'teal';
}
const { name, icon, color } = Astro.props;

const colorMap: Record<string, string> = {
  gold: '#c8a96e',
  rust: '#c1440e',
  teal: '#00F5FF',
};
const accent = colorMap[color] ?? '#888';
---
<div class="venus-zone" style={`--zone-accent: ${accent};`}>
  <div class="vz-icon" aria-hidden="true">{icon}</div>
  <div class="vz-content">
    <span class="vz-name">{name}</span>
    <div class="vz-body">
      <slot />
    </div>
  </div>
</div>

<style>
  .venus-zone {
    display: flex;
    gap: 1rem;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--border);
    border-left: 3px solid var(--zone-accent);
    background: rgba(255, 255, 255, 0.015);
    transition: background 0.2s;
  }

  .venus-zone:last-child {
    border-bottom: none;
  }

  .venus-zone:hover {
    background: rgba(255, 255, 255, 0.03);
  }

  .vz-icon {
    font-size: 1.4rem;
    flex-shrink: 0;
    padding-top: 0.1rem;
    width: 1.8rem;
    text-align: center;
  }

  .vz-name {
    display: block;
    font-family: 'Inter Tight', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--zone-accent);
    margin-bottom: 0.35rem;
  }

  .vz-body {
    font-family: 'Source Serif 4', serif;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-muted);
  }
</style>
