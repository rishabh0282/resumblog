---
interface Props {
  label?: string;
}
const { label = 'Speculative' } = Astro.props;
---
<div class="spec-callout">
  <span class="spec-label">{label}</span>
  <div class="spec-body">
    <slot />
  </div>
</div>

<style>
  .spec-callout {
    margin: 2rem 0;
    padding: 1.25rem 1.5rem;
    border: 1px dashed rgba(112, 0, 255, 0.35);
    border-left: 3px solid var(--accent-secondary, #7000FF);
    background: rgba(112, 0, 255, 0.04);
    border-radius: 0 4px 4px 0;
    position: relative;
  }

  .spec-label {
    display: inline-block;
    font-family: 'Geist Mono', monospace;
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent-secondary, #7000FF);
    background: rgba(112, 0, 255, 0.12);
    padding: 0.15em 0.6em;
    border-radius: 2px;
    margin-bottom: 0.75rem;
  }

  .spec-body {
    font-family: 'Source Serif 4', serif;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-muted);
  }
</style>
