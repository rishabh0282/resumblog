<div class="timeline">
  <slot />
</div>

<style>
  .timeline {
    margin: 2rem 0;
    position: relative;
    padding-left: 1.5rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 1px;
    background: linear-gradient(to bottom, var(--accent), rgba(0, 245, 255, 0.1));
  }
</style>
