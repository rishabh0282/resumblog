</Layout>

<style>
  /* ── Hero ───────────────────────────────────────────────────── */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: #060c18;
  }

  /* ── Text wall (Midjourney-style) ───────────────────────────── */
  .hero-textwall {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* Rows are injected by JS */
  :global(.hw-row) {
    display: flex;
    white-space: nowrap;
    will-change: transform;
    line-height: 1.1;
    height: 14px;
  }

  :global(.hw-row span) {
    font-family: 'Geist Mono', monospace;
    font-size: 0.62rem;
    color: rgba(60, 130, 210, 0.55);
    padding: 0 0.18em;
    letter-spacing: 0.06em;
    flex-shrink: 0;
  }

  :global(.hw-row span.hw-hi) {
    color: rgba(100, 180, 255, 0.85);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.hw-row) { animation: hw-scroll var(--hw-dur, 40s) linear infinite; }
    :global(.hw-row.hw-rtl) { animation-direction: reverse; }
  }

  @keyframes hw-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* Vignettes */
  .hw-vignette {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  /* Subtle center darkening — let text wall show at edges, fade near hero copy */
  .hw-vignette-radial {
    background: radial-gradient(
      ellipse 55% 65% at 50% 50%,
      rgba(6,12,24,0.82) 0%,
      rgba(6,12,24,0.40) 55%,
      transparent 100%
    );
  }

  .hw-vignette-top {
    background: linear-gradient(to bottom, #060c18 0%, transparent 20%);
  }

  .hw-vignette-bottom {
    background: linear-gradient(to top, #060c18 0%, transparent 20%);
  }

  /* ── Hero poster image ──────────────────────────────────────── */
  .hero-art {
    position: absolute;
    right: 0;
    top: 0;
    width: 52%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
  }

  .hero-art-img {
    width: 100%;
    height: 104%;
    object-fit: cover;
    object-position: center top;
    opacity: 0.28;
    mask-image: linear-gradient(to right, transparent 0%, black 35%, black 88%, transparent 100%),
                linear-gradient(to bottom, black 0%, black 90%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 35%, black 88%, transparent 100%),
                        linear-gradient(to bottom, black 0%, black 90%, transparent 100%);
    mask-composite: intersect;
    -webkit-mask-composite: source-in;
  }

  @media (max-width: 767px) {
    .hero-art { display: none; }
  }

  /* ── Hero inner ─────────────────────────────────────────────── */
  .hero-inner {
    position: relative;
    z-index: 2;
    text-align: left;
    max-width: 640px;
    padding: 0 clamp(1.5rem, 6vw, 6rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    align-self: center;
  }

  .hero-eyebrow {
    font-family: 'Geist Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    opacity: 0.9;
    margin-bottom: 1.25rem;
  }

  .hero-heading {
    font-family: 'Inter Tight', sans-serif;
    font-weight: 700;
    font-size: clamp(2.75rem, 8vw, 5.5rem);
    letter-spacing: -0.05em;
    color: #ffffff;
    line-height: 1.04;
    margin-bottom: 1.25rem;
    text-shadow: 0 2px 40px rgba(0,0,0,0.5);
  }

  .hero-sub {
    font-family: 'Inter', sans-serif;
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    color: rgba(255,255,255,0.5);
    margin-bottom: 2.5rem;
    max-width: 480px;
    line-height: 1.6;
  }

  .hero-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-primary {
    font-family: 'Geist Mono', monospace;
    font-size: 0.875rem;
    padding: 0.75rem 1.75rem;
    background: var(--accent);
    color: var(--bg);
    text-decoration: none;
    border-radius: 3px;
    font-weight: 500;
    transition: opacity 0.2s, box-shadow 0.2s;
    box-shadow: 0 0 20px rgba(0,245,255,0.2);
  }
  .btn-primary:hover { opacity: 0.88; box-shadow: 0 0 32px rgba(0,245,255,0.4); }

  .btn-ghost {
    font-family: 'Geist Mono', monospace;
    font-size: 0.875rem;
    padding: 0.75rem 1.75rem;
    border: 1px solid rgba(255,255,255,0.18);
    color: rgba(255,255,255,0.7);
    text-decoration: none;
    border-radius: 3px;
    transition: border-color 0.2s, color 0.2s;
    backdrop-filter: blur(4px);
  }
  .btn-ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* ── Resume Section ─────────────────────────────────────────── */
  .resume-section {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
  }

  .resume-track {
    display: flex;
    gap: 1.5rem;
    padding: 4rem clamp(1.5rem, 6vw, 6rem);
    height: 100vh;
    align-items: center;
  }

  .role-card {
    position: relative;
    flex: 0 0 420px;
    height: 420px;
    border-radius: 4px;
    overflow: hidden;
    padding: 2rem;
    display: flex;
    flex-direction: column;
  }

  .year-watermark {
    position: absolute;
    top: -0.5rem;
    right: -1rem;
    font-family: 'Inter Tight', sans-serif;
    font-weight: 700;
    font-size: 20vw;
    color: var(--text-primary);
    opacity: 0.04;
    line-height: 1;
    user-select: none;
    pointer-events: none;
  }

  .card-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
  }

  .card-company {
    font-family: 'Geist Mono', monospace;
    font-size: 0.75rem;
    color: var(--accent);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .card-title {
    font-family: 'Inter Tight', sans-serif;
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    line-height: 1.2;
  }

  .card-duration {
    font-family: 'Geist Mono', monospace;
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }

  .card-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .card-bullets li {
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
    padding-left: 1rem;
    position: relative;
  }

  .card-bullets li::before {
    content: '–';
    position: absolute;
    left: 0;
    color: var(--accent);
    opacity: 0.6;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
  }

  .tag {
    font-family: 'Geist Mono', monospace;
    font-size: 0.65rem;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 2px;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }

  /* ── Footer ─────────────────────────────────────────────────── */
  .site-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding: 2rem clamp(1.5rem, 6vw, 6rem);
    border-top: 1px solid var(--border);
  }

  .footer-name {
    font-family: 'Inter Tight', sans-serif;
    font-weight: 700;
    font-size: clamp(1.25rem, 3vw, 2rem);
    letter-spacing: -0.04em;
    color: var(--text-primary);
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .footer-links a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer-links a:hover { color: var(--accent); }

  .footer-email {
    font-family: 'Geist Mono', monospace;
    font-size: 0.8rem;
  }

  /* ── Mobile: vertical timeline instead of horizontal scroll ── */
  @media (max-width: 767px) {
    .resume-track {
      flex-direction: column;
      height: auto;
      align-items: stretch;
      padding: 2rem 1.5rem;
    }

    .role-card {
      flex: none;
      width: 100%;
      height: auto;
      min-height: 300px;
    }

    .year-watermark {
      font-size: 40vw;
    }
  }
</style>

<script>
  // ── Hero text wall (Midjourney-style) ─────────────────────────
  (function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const wall = document.getElementById('hero-textwall');
    if (!wall) return;

    // Dense character pool — mix of latin, digits, symbols for Midjourney matrix look
    const chars = 'abcdefghijklmnopqrstuvwxyz0123456789.,;:!?/-+=<>[]{}|~@#$%^&*()_'
      .split('');

    // Row height matches CSS (14px)
    const ROW_H = 14;
    const viewH = window.innerHeight;
    const numRows = Math.ceil(viewH / ROW_H) + 2;

    // How many chars fill the viewport width × 2 for seamless loop
    // Each char is ~9px wide at 0.62rem with 0.06em spacing
    const charsPerHalf = Math.ceil((window.innerWidth * 2.2) / 9);

    for (let r = 0; r < numRows; r++) {
      const row = document.createElement('div');
      row.className = 'hw-row' + (r % 3 === 1 ? ' hw-rtl' : '');

      const dur = 30 + (r % 7) * 6;
      row.style.setProperty('--hw-dur', `${dur}s`);
      row.style.animationDelay = `-${(r * 3.3) % dur}s`;

      // Build one half, then duplicate for seamless loop
      const half = [];
      for (let c = 0; c < charsPerHalf; c++) {
        half.push(chars[Math.floor(Math.random() * chars.length)]);
      }
      const full = [...half, ...half];

      full.forEach((ch, i) => {
        const s = document.createElement('span');
        s.textContent = ch;
        if ((i + r * 7) % 15 === 0) s.classList.add('hw-hi');
        row.appendChild(s);
      });

      wall.appendChild(row);
    }
  })();

  // ── GSAP Horizontal Scroll Resume (desktop only) ──────────────
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
      window.innerWidth >= 768) {
    gsap.registerPlugin(ScrollTrigger);

    const track = document.getElementById('resume-track');
    const section = document.getElementById('resume');

    if (track && section) {
      const cards = track.querySelectorAll('.role-card');
      const totalScrollWidth = track.scrollWidth - window.innerWidth;

      gsap.to(track, {
        x: -totalScrollWidth,
        ease: 'none',
        scrollTrigger: {
          trigger: section,
          start: 'top top',
          end: () => `+=${totalScrollWidth}`,
          pin: true,
          scrub: 1,
          anticipatePin: 1,
          invalidateOnRefresh: true,
        },
      });
    }
  }
</script>
