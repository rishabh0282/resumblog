            "dark",
            "light"
          ],
          "default": "dark"
        },
        "hasInteractiveComponents": {
          "type": "boolean",
          "default": false
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "date",
        "tags",
        "excerpt"
      ],
      "additionalProperties": false
