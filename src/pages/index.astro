import Publications from '../components/Publications.astro';
import Certifications from '../components/Certifications.astro';
import Education from '../components/Education.astro';

const roles = [
  {
    company: 'Factech',
    title: 'QA Engineer',
    duration: 'Jan 2026 – Present',
    year: '2026',
    bullets: [
      'Built Appium (Python) mobile test framework for Android Visitor Management System; found 10+ critical defects.',
      'Executed 50+ test cases across functional, security, and integration scenarios; tracked in JIRA.',
      'API tested with Postman across staff, visitor, and reporting modules; documented 500 Internal Server errors.',
    ],
    tags: ['Appium', 'Python', 'Postman', 'JIRA', 'Android SDK'],
  },
  {
    company: 'Freelance',
    title: 'QA Automation Engineer',
    duration: 'Aug 2023 – Dec 2025',
    year: '2023',
    bullets: [
      'Delivered Selenium automation frameworks for 5+ clients in e-commerce, fintech, and SaaS; 200+ test cases.',
      'Reduced manual testing effort by 60%; CI-integrated all suites with Jenkins.',
      'Reported via ExtentReports and Allure; maintained defect documentation in JIRA per engagement.',
    ],
    tags: ['Selenium', 'Java', 'TestNG', 'Jenkins', 'ExtentReports'],
  },
  {
    company: 'IBM India',
    title: 'Associate Systems Engineer',
    duration: 'Jun 2022 – Jul 2023',
    year: '2022',
    bullets: [
      'Developed Selenium WebDriver frameworks for enterprise apps; reduced regression time by 50%.',
      'Designed 180+ automated test scripts across 5 modules with cross-browser coverage via Selenium Grid.',
      'Integrated suites into Jenkins CI/CD pipelines; cut post-release issues by 15%.',
    ],
    tags: ['Selenium', 'Java', 'TestNG', 'Jenkins', 'Selenium Grid'],
  },
  {
    company: 'Collaborative Intelligence',
    title: 'AI Engineer (Intern)',
    duration: 'Jun 2021 – May 2022',
    year: '2021',
    bullets: [
      'Built computer vision pipelines with YOLO architectures; improved detection accuracy by 15%+.',
      'Integrated AI workflows into production with automated validation and QA checks.',
      'Published 5 peer-reviewed papers across IEEE, Springer, and Wiley.',
    ],
    tags: ['Python', 'OpenCV', 'YOLO', 'PyTorch', 'Research'],
  },
];
---

<Layout title="Rishabh Tiwari - QA Engineer & SDET">
  <!-- Hero -->
  <section class="hero">
    <!-- Midjourney-style: dense scrolling text rows -->
    <div class="hero-textwall" aria-hidden="true" id="hero-textwall"></div>

    <!-- Vignette overlays -->
    <div class="hw-vignette hw-vignette-radial" aria-hidden="true"></div>
    <div class="hw-vignette hw-vignette-top" aria-hidden="true"></div>
    <div class="hw-vignette hw-vignette-bottom" aria-hidden="true"></div>

    <!-- Hero poster image -->
    <div class="hero-art" aria-hidden="true">
      <img src="/Gemini_Generated_Image_2f8r9p2f8r9p2f8r.png" alt="" class="hero-art-img" />
    </div>

    <div class="hero-inner">
      <p class="hero-eyebrow">QA Engineer · SDET · AI Researcher</p>
      <h1 class="hero-heading">Quality is a<br/>first-class concern.</h1>
      <p class="hero-sub">Automation frameworks, API validation, and published AI research.</p>
      <nav class="hero-links">
        <a href="#resume" class="btn-primary">View Resume ↓</a>
        <a href="/blog" class="btn-ghost">Read Writing →</a>
      </nav>
    </div>
  </section>

  <!-- Horizontal Scroll Resume -->
  <section id="resume" class="resume-section">
    <div class="resume-track" id="resume-track">
      {roles.map((role) => (
        <article class="role-card glass">
          <span class="year-watermark" aria-hidden="true">{role.year}</span>
          <div class="card-inner">
            <p class="card-company">{role.company}</p>
            <h2 class="card-title">{role.title}</h2>
            <p class="card-duration">{role.duration}</p>
            <ul class="card-bullets">
              {role.bullets.map((b) => <li>{b}</li>)}
            </ul>
            <div class="card-tags">
              {role.tags.map((t) => <span class="tag">{t}</span>)}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <About />
  <Projects />
  <Publications />
  <Certifications />
  <Education />

  <!-- Footer -->
  <footer class="site-footer">
    <span class="footer-name">Rishabh Tiwari</span>
    <div class="footer-links">
      <a href="https://github.com/rishabh0282" aria-label="GitHub" target="_blank" rel="noopener">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.17 6.839 9.49.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.604-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.464-1.11-1.464-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.167 22 16.418 22 12c0-5.523-4.477-10-10-10z"/>
        </svg>
      </a>
      <a href="https://linkedin.com/in/iamrishabh27" aria-label="LinkedIn" target="_blank" rel="noopener">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </a>
      <a href="mailto:rishabhofficial244@gmail.com" class="footer-email">rishabhofficial244@gmail.com</a>
    </div>
