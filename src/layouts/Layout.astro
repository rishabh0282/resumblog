---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description = 'QA & Automation Engineer - portfolio and writing.', ogImage } = Astro.props;
const siteOrigin = Astro.site ?? null;
const canonicalURL = siteOrigin ? new URL(Astro.url.pathname, siteOrigin).toString() : null;
const resolvedOgImage = ogImage
  ? siteOrigin
    ? new URL(ogImage, siteOrigin).toString()
    : ogImage
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="author" content="Rishabh Tiwari" />
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- OG -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    {resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Fonts: loaded here ONLY - never in MDX or child components -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,400;0,700;1,400&family=Inter:wght@400;500&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;1,8..60,400&display=swap"
      rel="stylesheet"
    />
    <!-- Geist Mono: self-hosted via the geist npm package -->
    <style>
      @font-face {
        font-family: 'Geist Mono';
        src: url('https://cdn.jsdelivr.net/npm/geist@1.3.0/dist/fonts/geist-mono/GeistMono-Regular.woff2') format('woff2');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Geist Mono';
        src: url('https://cdn.jsdelivr.net/npm/geist@1.3.0/dist/fonts/geist-mono/GeistMono-Medium.woff2') format('woff2');
        font-weight: 500;
        font-style: normal;
        font-display: swap;
      }
    </style>

  </head>

  <body>
    <!-- Noise overlay: layout shell only, NOT inside article reading container -->
    <div id="noise" aria-hidden="true"></div>

    <!-- Custom cursor -->
    <div id="cursor" aria-hidden="true"></div>

    <!-- Site nav -->
    <nav class="site-nav" id="site-nav">
      <a class="nav-home" href="/">Rishabh Tiwari</a>
      <div class="nav-links">
        <a href="/#resume"         class="nav-link nav-section" data-nav-match="/" data-section="resume">Resume</a>
        <a href="/#about"          class="nav-link nav-section" data-nav-match="/" data-section="about">About</a>
        <a href="/#projects"       class="nav-link nav-section" data-nav-match="/" data-section="projects">Projects</a>
        <a href="/#publications"   class="nav-link nav-section" data-nav-match="/" data-section="publications">Publications</a>
        <a href="/#certifications" class="nav-link nav-section" data-nav-match="/" data-section="certifications">Certifications</a>
        <span class="nav-divider" aria-hidden="true"></span>
        <a href="/blog" class="nav-link" data-nav-match="/blog">Blog</a>
      </div>
    </nav>

    <slot />

    <style>
      .site-nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 9998;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 1.5rem;
        background: rgba(10, 10, 10, 0.82);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.07);
      }

      .nav-home {
        font-family: 'Geist Mono', monospace;
        font-size: 0.75rem;
        color: var(--text-primary);
        text-decoration: none;
        letter-spacing: 0.03em;
        opacity: 0.85;
        transition: opacity 0.15s;
      }
      .nav-home:hover { opacity: 1; }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 1.5rem;
      }

      .nav-link {
        font-family: 'Inter', sans-serif;
        font-size: 0.78rem;
        color: var(--text-muted);
        text-decoration: none;
        letter-spacing: 0.02em;
        transition: color 0.15s;
        position: relative;
        white-space: nowrap;
      }
      .nav-link:hover { color: var(--text-primary); }
      .nav-link.active { color: var(--accent); }
      .nav-link.active::after {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        bottom: -3px;
        height: 1px;
        background: var(--accent);
        opacity: 0.6;
      }

      .nav-divider {
        width: 1px;
        height: 14px;
        background: rgba(255, 255, 255, 0.12);
        flex-shrink: 0;
      }

      /* Hide portfolio section anchors on mobile — they only exist on / */
      @media (max-width: 860px) {
        .nav-section { display: none; }
        .nav-divider  { display: none; }
      }
    </style>

    <script>
      // ── Active nav link + scroll-spy ─────────────────────────
      (function () {
        const path = window.location.pathname;
        const isHome = path === '/' || path === '';

        // Blog page: highlight Blog link only
        if (!isHome) {
          document.querySelectorAll('.nav-link').forEach((el) => {
            const match = el.getAttribute('data-nav-match') ?? '';
            if (match === '/blog' && path.startsWith('/blog')) el.classList.add('active');
          });
          return;
        }

        // Home: scroll-spy via IntersectionObserver
        const sectionLinks = Array.from(document.querySelectorAll('.nav-link[data-section]'));
        const sectionIds = sectionLinks.map((el) => el.getAttribute('data-section'));

        function setActive(id) {
          sectionLinks.forEach((el) => {
            const matches = el.getAttribute('data-section') === id;
            el.classList.toggle('active', matches);
          });
        }

        // Start with Resume highlighted
        setActive('resume');

        if ('IntersectionObserver' in window) {
          // Track which sections are currently visible
          const visible = new Set();

          const io = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) visible.add(entry.target.id);
              else visible.delete(entry.target.id);
            });
            // Highlight the first visible section in page order
            const active = sectionIds.find((id) => visible.has(id));
            if (active) setActive(active);
          }, { rootMargin: '-44px 0px -55% 0px', threshold: 0 });

          sectionIds.forEach((id) => {
            const el = document.getElementById(id);
            if (el) io.observe(el);
          });
        }
      })();

      // ── Custom cursor (immediate follow, no lag) ──────────────
      const root = document.documentElement;
      const cursor = document.getElementById('cursor');
      const canUseCustomCursor =
        window.matchMedia('(pointer: fine)').matches &&
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (cursor && canUseCustomCursor) {
        root.classList.add('js-cursor-enabled');

        const interactiveSelector = 'a, button, [role="button"], input, textarea, select, label';

        document.addEventListener('mousemove', (e) => {
          cursor.style.left = `${e.clientX}px`;
          cursor.style.top = `${e.clientY}px`;
          const target = e.target instanceof Element ? e.target : null;
          if (target && target !== cursor && target.closest(interactiveSelector)) {
            cursor.classList.add('hovering');
          } else {
            cursor.classList.remove('hovering');
          }
        }, { passive: true });
      } else {
        root.classList.remove('js-cursor-enabled');
        if (cursor) {
          cursor.style.display = 'none';
        }
      }
    </script>
  </body>
</html>
