---
import Layout from '../layouts/Layout.astro';

const roles = [
  {
    company: 'Acme Corp',
    title: 'Senior QA Automation Engineer',
    duration: '2022 – Present',
    year: '2022',
    bullets: [
      'Built end-to-end test suite covering 800+ scenarios across web and API layers.',
      'Reduced release cycle from 2 weeks to 3 days through CI/CD pipeline automation.',
      'Led migration from legacy Selenium to Playwright, cutting test runtime by 60%.',
    ],
    tags: ['Playwright', 'TypeScript', 'GitHub Actions', 'Docker'],
  },
  {
    company: 'Globex Solutions',
    title: 'QA Engineer',
    duration: '2019 – 2022',
    year: '2019',
    bullets: [
      'Owned manual and automated test strategy for a fintech SaaS product.',
      'Authored test plans, bug reports, and regression suites for quarterly releases.',
      'Mentored two junior QA engineers in test automation fundamentals.',
    ],
    tags: ['Cypress', 'JavaScript', 'JIRA', 'Postman'],
  },
  {
    company: 'Initech Systems',
    title: 'Junior QA Analyst',
    duration: '2017 – 2019',
    year: '2017',
    bullets: [
      'Executed functional and regression testing across a suite of internal tools.',
      'Documented defects and collaborated with dev team to achieve zero P1 bugs at launch.',
      'Introduced exploratory testing sessions that surfaced 30+ unreported edge cases.',
    ],
    tags: ['Selenium', 'Java', 'TestNG', 'SQL'],
  },
];
---

<Layout title="[Your Name] — QA & Automation Engineer">
  <!-- Hero -->
  <section class="hero">
    <div class="hero-inner">
      <h1 class="hero-heading">I build reliable software.</h1>
      <p class="hero-sub">QA &amp; Automation Engineer. Currently open to opportunities.</p>
      <nav class="hero-links">
        <a href="#resume" class="btn-primary">View Resume ↓</a>
        <a href="/blog" class="btn-ghost">Read Writing →</a>
      </nav>
    </div>
  </section>

  <!-- Horizontal Scroll Resume -->
  <section id="resume" class="resume-section">
    <div class="resume-track" id="resume-track">
      {roles.map((role) => (
        <article class="role-card glass">
          <span class="year-watermark" aria-hidden="true">{role.year}</span>
          <div class="card-inner">
            <p class="card-company">{role.company}</p>
            <h2 class="card-title">{role.title}</h2>
            <p class="card-duration">{role.duration}</p>
            <ul class="card-bullets">
              {role.bullets.map((b) => <li>{b}</li>)}
            </ul>
            <div class="card-tags">
              {role.tags.map((t) => <span class="tag">{t}</span>)}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Footer -->
  <footer class="site-footer">
    <span class="footer-name">[Your Name]</span>
    <div class="footer-links">
      <a href="https://github.com" aria-label="GitHub" target="_blank" rel="noopener">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.17 6.839 9.49.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.604-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.464-1.11-1.464-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.167 22 16.418 22 12c0-5.523-4.477-10-10-10z"/>
        </svg>
      </a>
      <a href="https://linkedin.com" aria-label="LinkedIn" target="_blank" rel="noopener">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </a>
      <a href="mailto:hello@example.com" class="footer-email">hello@example.com</a>
    </div>
  </footer>
</Layout>

<style>
  /* ── Hero ───────────────────────────────────────────────────── */
  .hero {
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 0 clamp(1.5rem, 6vw, 6rem);
  }

  .hero-inner {
    max-width: 900px;
  }

  .hero-heading {
    font-family: 'Inter Tight', sans-serif;
    font-weight: 700;
    font-size: clamp(2.5rem, 8vw, 5rem);
    letter-spacing: -0.05em;
    color: var(--text-primary);
    line-height: 1.05;
    margin-bottom: 1rem;
  }

  .hero-sub {
    font-family: 'Inter', sans-serif;
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: var(--text-muted);
    margin-bottom: 2.5rem;
  }

  .hero-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-primary {
    font-family: 'Geist Mono', monospace;
    font-size: 0.875rem;
    padding: 0.75rem 1.5rem;
    background: var(--accent);
    color: var(--bg);
    text-decoration: none;
    border-radius: 2px;
    font-weight: 500;
    transition: opacity 0.2s;
  }
  .btn-primary:hover { opacity: 0.85; }

  .btn-ghost {
    font-family: 'Geist Mono', monospace;
    font-size: 0.875rem;
    padding: 0.75rem 1.5rem;
    border: 1px solid var(--border);
    color: var(--text-primary);
    text-decoration: none;
    border-radius: 2px;
    transition: border-color 0.2s, color 0.2s;
  }
  .btn-ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* ── Resume Section ─────────────────────────────────────────── */
  .resume-section {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
  }

  .resume-track {
    display: flex;
    gap: 1.5rem;
    padding: 4rem clamp(1.5rem, 6vw, 6rem);
    height: 100vh;
    align-items: center;
  }

  .role-card {
    position: relative;
    flex: 0 0 420px;
    height: 420px;
    border-radius: 4px;
    overflow: hidden;
    padding: 2rem;
    display: flex;
    flex-direction: column;
  }

  .year-watermark {
    position: absolute;
    top: -0.5rem;
    right: -1rem;
    font-family: 'Inter Tight', sans-serif;
    font-weight: 700;
    font-size: 20vw;
    color: var(--text-primary);
    opacity: 0.04;
    line-height: 1;
    user-select: none;
    pointer-events: none;
  }

  .card-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
  }

  .card-company {
    font-family: 'Geist Mono', monospace;
    font-size: 0.75rem;
    color: var(--accent);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .card-title {
    font-family: 'Inter Tight', sans-serif;
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    line-height: 1.2;
  }

  .card-duration {
    font-family: 'Geist Mono', monospace;
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }

  .card-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .card-bullets li {
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
    padding-left: 1rem;
    position: relative;
  }

  .card-bullets li::before {
    content: '–';
    position: absolute;
    left: 0;
    color: var(--accent);
    opacity: 0.6;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
  }

  .tag {
    font-family: 'Geist Mono', monospace;
    font-size: 0.65rem;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 2px;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }

  /* ── Footer ─────────────────────────────────────────────────── */
  .site-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding: 2rem clamp(1.5rem, 6vw, 6rem);
    border-top: 1px solid var(--border);
  }

  .footer-name {
    font-family: 'Inter Tight', sans-serif;
    font-weight: 700;
    font-size: clamp(1.25rem, 3vw, 2rem);
    letter-spacing: -0.04em;
    color: var(--text-primary);
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .footer-links a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer-links a:hover { color: var(--accent); }

  .footer-email {
    font-family: 'Geist Mono', monospace;
    font-size: 0.8rem;
  }

  /* ── Mobile: vertical timeline instead of horizontal scroll ── */
  @media (max-width: 767px) {
    .resume-track {
      flex-direction: column;
      height: auto;
      align-items: stretch;
      padding: 2rem 1.5rem;
    }

    .role-card {
      flex: none;
      width: 100%;
      height: auto;
      min-height: 300px;
    }

    .year-watermark {
      font-size: 40vw;
    }
  }
</style>

<script>
  // ── GSAP Horizontal Scroll Resume (desktop only) ──────────────
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
      window.innerWidth >= 768) {
    gsap.registerPlugin(ScrollTrigger);

    const track = document.getElementById('resume-track');
    const section = document.getElementById('resume');

    if (track && section) {
      const cards = track.querySelectorAll('.role-card');
      const totalScrollWidth = track.scrollWidth - window.innerWidth;

      gsap.to(track, {
        x: -totalScrollWidth,
        ease: 'none',
        scrollTrigger: {
          trigger: section,
          start: 'top top',
          end: () => `+=${totalScrollWidth}`,
          pin: true,
          scrub: 1,
          anticipatePin: 1,
          invalidateOnRefresh: true,
        },
      });
    }
  }
</script>
